# Local Postgres (Arch: installed natively, no Docker).
# The password here must match the role you created with CREATE ROLE.
DATABASE_URL=postgresql://dwa:CHANGE_ME@localhost:5432/dwa

# Set to true only when Postgres is remote and terminates TLS.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Salt for hashing visitor IPs. Any long random string. Changing it invalidates
# existing hashes, which only affects duplicate detection.
IP_HASH_SALT=change-me-to-a-long-random-string

# Public origin, used for canonical URLs and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signing key for admin session cookies. Any random string >= 32 chars.
AUTH_SECRET=change-me-openssl-rand-hex-32

# Analytics & ad tracking. All optional — leave blank and no tags load, no
# consent banner shows. Fill them in to enable Google Consent Mode v2 + tags.
#   GA_ID:             GA4 measurement id, e.g. G-XXXXXXXXXX
#   GOOGLE_ADS_ID:     Google Ads conversion id, e.g. AW-XXXXXXXXXX
#   GOOGLE_ADS_LEAD_LABEL: the conversion label for the lead form (from Google Ads)
#   META_PIXEL_ID:     Meta (Facebook) pixel id
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# Lead form abuse limits.
LEADS_RATE_LIMIT=5
LEADS_RATE_WINDOW=3600

# SEO audit. The audit runs without this — the public PageSpeed endpoint has a
# low shared quota — but a key (free from Google Cloud, "PageSpeed Insights API")
# lifts it to 25k/day and makes the performance half reliable.
PAGESPEED_API_KEY=
# PAGESPEED_TIMEOUT_MS=40000

# Keyword tool. How many live SERP lookups to run in parallel when scoring
# difficulty for the top phrases. Lower it if the host IP gets rate-limited.
# KEYWORDS_SERP_CONCURRENCY=4

# Outbound mail. STARTTLS on 587.
SMTP_HOST=your-mail-host
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASSWORD=set-this-in-env-local-only
SMTP_FROM="Digital Web Assurances <no-reply@yourdomain.com>"
# Where new-lead notifications are sent.
LEAD_NOTIFY_TO=you@yourdomain.com
