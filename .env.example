# Local Postgres (Arch: installed natively, no Docker).
# The password here must match the role you created with CREATE ROLE.
DATABASE_URL=postgresql://dwa:CHANGE_ME@localhost:5432/dwa

# Set to true only when Postgres is remote and terminates TLS.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Salt for hashing visitor IPs. Any long random string. Changing it invalidates
# existing hashes, which only affects duplicate detection.
IP_HASH_SALT=change-me-to-a-long-random-string

# Public origin, used for canonical URLs and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
